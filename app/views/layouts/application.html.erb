<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dental Talent Onboarding" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
        <%= link_to "Dental Talent", root_path, class: "text-lg font-semibold text-teal-700" %>
        <nav class="flex items-center gap-4 text-sm">
          <% if user_signed_in? %>
            <span class="text-slate-500"><%= current_user.email %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                  class: "rounded-md px-3 py-1.5 text-slate-700 hover:bg-slate-100" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-slate-700 hover:text-teal-700" %>
            <%= link_to "Sign up", new_user_registration_path,
                  class: "rounded-md bg-teal-600 px-3 py-1.5 text-white hover:bg-teal-700" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
