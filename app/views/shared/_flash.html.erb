<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% color = type.to_s == "alert" ? "bg-red-50 text-red-800 border-red-200" : "bg-emerald-50 text-emerald-800 border-emerald-200" %>
  <div class="mb-4 rounded-md border <%= color %> px-4 py-3 text-sm"><%= message %></div>
<% end %>
