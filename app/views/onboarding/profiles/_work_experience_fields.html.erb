<div class="rounded-md border border-slate-200 bg-slate-50 p-4" data-nested-form-row>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :job_title, class: "text-sm font-medium text-slate-700" %>
      <%= f.text_field :job_title, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :company_name, class: "text-sm font-medium text-slate-700" %>
      <%= f.text_field :company_name, class: onboarding_input_classes %>
    </div>
    <div class="sm:col-span-2">
      <%= f.label :responsibilities, class: "text-sm font-medium text-slate-700" %>
      <%= f.text_area :responsibilities, rows: 3, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :start_date, class: "text-sm font-medium text-slate-700" %>
      <%= f.date_field :start_date, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :end_date, class: "text-sm font-medium text-slate-700" %>
      <%= f.date_field :end_date, class: onboarding_input_classes %>
    </div>
  </div>
  <div class="mt-3 flex items-center justify-between">
    <label class="flex items-center gap-2 text-sm text-slate-700">
      <%= f.check_box :current_job, class: "h-4 w-4 rounded border-slate-300 text-teal-600" %>
      This is my current job
    </label>
    <div>
      <%= f.hidden_field :_destroy %>
      <button type="button" data-action="nested-form#remove" class="text-sm text-red-600 hover:text-red-800">Remove</button>
    </div>
  </div>
</div>
