<div class="rounded-md border border-slate-200 bg-slate-50 p-4" data-nested-form-row>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :study, "Study / course", class: "text-sm font-medium text-slate-700" %>
      <%= f.text_field :study, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :institution, class: "text-sm font-medium text-slate-700" %>
      <%= f.text_field :institution, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :city_and_country, "City and country", class: "text-sm font-medium text-slate-700" %>
      <%= f.text_field :city_and_country, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :level, class: "text-sm font-medium text-slate-700" %>
      <%= f.select :level, Education.levels.keys.map { |l| [l.humanize, l] }, { include_blank: "—" }, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :start_date, class: "text-sm font-medium text-slate-700" %>
      <%= f.date_field :start_date, class: onboarding_input_classes %>
    </div>
    <div>
      <%= f.label :end_date, class: "text-sm font-medium text-slate-700" %>
      <%= f.date_field :end_date, class: onboarding_input_classes %>
    </div>
  </div>
  <div class="mt-3 flex justify-end">
    <%= f.hidden_field :_destroy %>
    <button type="button" data-action="nested-form#remove" class="text-sm text-red-600 hover:text-red-800">Remove</button>
  </div>
</div>
