<% content_for :title, "Upload your CV" %>

<%= render "onboarding/steps/progress", step: 1 %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-semibold text-slate-900">Upload your CV</h1>
  <p class="mt-2 text-slate-600">
    We will automatically fill in as much of your candidate profile as possible.
    You can review and edit everything before saving.
  </p>

  <% if @document.errors.any? %>
    <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc pl-5">
        <% @document.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: onboarding_cv_upload_path, method: :post, multipart: true,
        data: { controller: "cv-upload" }, class: "mt-6 space-y-5" do |form| %>

    <label data-cv-upload-target="dropzone"
           data-action="dragover->cv-upload#dragover dragleave->cv-upload#dragleave drop->cv-upload#drop"
           class="flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-slate-300 bg-white px-6 py-10 text-center transition hover:border-teal-400">
      <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
      </svg>
      <span class="mt-3 text-sm font-medium text-slate-700">Drag &amp; drop your CV here, or click to browse</span>
      <span class="mt-1 text-xs text-slate-500">PDF, DOC or DOCX &middot; up to <%= Setting.max_cv_file_size_bytes / 1.megabyte %> MB</span>
      <span data-cv-upload-target="filename" class="mt-3 text-sm font-medium text-teal-700"></span>
      <%= form.file_field :file, accept: ".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            required: true, class: "hidden", data: { cv_upload_target: "input", action: "cv-upload#selected" },
            name: "candidate_document[file]" %>
    </label>

    <label class="flex items-start gap-3 text-sm text-slate-700">
      <%= check_box_tag :consent, "1", false, required: true, class: "mt-0.5 h-4 w-4 rounded border-slate-300 text-teal-600" %>
      <span>
        I agree that my CV and profile information may be processed to create and
        improve my candidate profile.
      </span>
    </label>

    <div class="flex items-center gap-3">
      <%= form.submit "Analyze CV", class: "rounded-md bg-teal-600 px-5 py-2.5 text-white hover:bg-teal-700" %>
      <%= link_to "Continue manually", edit_onboarding_profile_path,
            class: "text-sm text-slate-600 underline hover:text-slate-800" %>
    </div>
  <% end %>
</div>
