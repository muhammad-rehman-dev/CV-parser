# Copy this file to .env and fill in your own values. .env is gitignored.

# --- CV parsing / LLM ---
# Provider used by Cv::LlmExtractor. Supported: gemini, groq, openai.
# Leave everything blank to run with the local heuristic parser only.
CV_LLM_PROVIDER=gemini
CV_LLM_MODEL=gemini-flash-latest

# Google Gemini (free tier). Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Alternative providers (optional). Groq is OpenAI-compatible.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Onboarding completion webhook (optional) ---
CANDIDATE_ONBOARDING_WEBHOOK_URL=

# --- Recruitment team notification recipient ---
RECRUITMENT_TEAM_EMAIL=recruitment@example.com
